# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Brain databases (contain personal data — never commit)
*.db
*.db-wal
*.db-shm
*.db.backup*

# Test artifacts
tests/results/
tests/baselines/
tests/relearned_*.db

# Build output
*.plugin

# Environment
.env
.venv/
venv/
node_modules/

# Plugin-scoped runtime (installed by hooks/scripts/ensure-runtime.sh)
bin/*
!bin/brain-watch
!bin/brain-dashboard
py/
.runtime-ready

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs and temp files
brain.log
daemon.log
*.zip
tmp_*

# OS
.DS_Store
Thumbs.db

# Embedder model cache
servers/models/

# Historical simulation data — not part of source
archives/

# Claude Code — only track settings.json. Do NOT track .claude/skills/: under
# CC 2.1.157+ any .claude/skills/<name> dir auto-loads as an inline plugin,
# which shadows the marketplace 'brain' plugin by name and drops its MCP server
# (worst in worktrees, where the symlink materializes as a broken text file).
.claude/*
!.claude/settings.json

# docs/ design docs ARE tracked (un-ignored 2026-05-30 — the blanket ignore
# left existing docs tracked-but-ignored, warning on every doc commit). The
# historical archive (superseded handoffs + multi-MB session-log dumps) stays out.
docs/archive/
eval/results/
eval/fixtures/brain_eval_copy.db*
eval/fixtures/eval_daemon.log
# Per-run eval artifacts — work-in-progress reports, not source.
eval/longmem/reports/
eval/encoder_eval/reports/
eval/replay_snapshots/
eval/reports/
eval/aspects_v1_classified_run_summary.json
eval/oracle_audit/endo_surface_corpus.json
# Real-session-derived eval corpora — personal data, never commit.
# (The public LongMemEval benchmark longmemeval_oracle.json stays tracked.)
eval/longmem/data/realchat_sessions.json
eval/longmem/data/realchat_oracle.json
exports/

# Research outputs — large (26MB+), not source code
references/research-agent-outputs/

# Session conversations and logs — personal data (400MB+)
conversations/
logs/

# Stale data copies
data/*.db
data/*.db-*
