#!/bin/bash
# brain-dashboard — launches the read-only brain dashboard (http://127.0.0.1:47303).
#
# On the Bash tool's $PATH via the plugin's bin/ while the plugin is enabled, so
# it runs from any repo as `brain-dashboard`. The dashboard is a standalone
# threaded HTTP server bound to 127.0.0.1; it reads live data via the daemon TCP
# socket (uid-derived port) and falls back to read-only SQLite when the daemon is
# down. Override the port with DASHBOARD_PORT.
#
# Usage: brain-dashboard
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# brain-env.sh sets $BRAIN_PYTHON + $PLUGIN_DIR and bootstraps the runtime.
# 1>&2: keep bootstrap chatter off the dashboard's stdout.
source "$ROOT/hooks/scripts/brain-env.sh" 1>&2
# resolve-brain-db.sh exports BRAIN_DB_DIR for the dashboard's read-only SQLite
# fallback (incl. the $CLAUDE_PLUGIN_DATA standard location). Best-effort —
# never block the launch; live data still comes via the daemon socket.
source "$ROOT/hooks/scripts/resolve-brain-db.sh" 1>&2 || true
exec "$BRAIN_PYTHON" "$PLUGIN_DIR/dashboard/brain_dashboard_standalone.py" "$@"
