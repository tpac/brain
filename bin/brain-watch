#!/bin/bash
# brain-watch — /watch self-channel listener launcher.
#
# On the Bash tool's $PATH via the plugin's bin/ (Claude Code adds it while the
# plugin is enabled), so it runs from ANY repo or session with no path to fill
# in. Routes through brain-env.sh — the same python resolution every launcher
# uses (bundled venv, ensure-runtime bootstrap, PYTHONHOME hygiene). The poller
# finds the daemon by port (uid-derived), not by path.
#
# Usage: brain-watch <session_id> [fast_s=5] [slow_s=60] [backoff=2.0]
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# brain-env.sh sets $BRAIN_PYTHON + $PLUGIN_DIR and bootstraps the runtime.
# 1>&2: our stdout is the Monitor event stream — keep bootstrap chatter off it.
source "$ROOT/hooks/scripts/brain-env.sh" 1>&2
exec "$BRAIN_PYTHON" "$PLUGIN_DIR/hooks/scripts/self_inbox_poller.py" "$@"
